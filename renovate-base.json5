{
  // Base Renovate preset for all Resonant repos (Python/uv and npm).
  // Shared settings inherited by both library and project presets.
  // Do not extend this directly — use renovate-library.json5 or renovate-project.json5.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    "helpers:pinGitHubActionDigestsToSemver",
  ],

  // Wait 3 days before suggesting updates to reduce supply chain risk.
  // Security updates bypass this and are raised immediately.
  // Automatically open a PR when Renovate deprecates config options.
  "configMigration": true,

  "minimumReleaseAge": "3 days",

  "lockFileMaintenance": {
    "enabled": true,
  },

  // Separate each major update for individual review.
  "separateMultipleMajor": true,

  "packageRules": [
    // Group all non-major updates into a single PR.
    // Avoid group:all — it bundles major updates with minor/patch, making it
    // impossible to review and merge them independently. If a major update
    // fails CI, it blocks all the safe minor/patch updates too.
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
    },
    // Group non-major dev tool updates into their own PR, separate from the
    // main "all non-major" group. "dependency-groups" matches Python (PEP 735),
    // "devDependencies" matches npm. This allows library presets to automerge
    // dev tools independently. Major dev tool updates get their own PRs
    // via the root-level separateMultipleMajor setting.
    {
      "matchDepTypes": ["dependency-groups", "devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps",
    },
    // Django minor versions are significant, so pull major+minor out of the
    // "all non-major" group into their own PR. Patch updates are independent
    // and stay in their default groups.
    {
      "matchPackageNames": ["django"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "django",
    },
    // Keep the type checking toolchain together in one PR. The "compatible-mypy"
    // extra of django-stubs and djangorestframework-stubs always caps mypy below
    // its next minor release (e.g. "mypy<2.4,>=1.13"). The cap is lifted in a
    // later patch release of each stubs package: django-stubs usually within
    // days of a mypy release, djangorestframework-stubs up to two weeks after
    // that. A lone mypy minor bump therefore cannot lock until both stubs
    // catch up, and would stall the whole "dev dependencies" group. mypy patch
    // releases are always within the allowed range, so they stay in
    // "dev dependencies". django-stubs-ext must stay in sync with django-stubs,
    // so it follows the stubs here. Keeping these packages together takes
    // precedence over keeping the stubs' major.minor aligned with the "django"
    // PR.
    {
      "matchPackageNames": ["mypy", "django-stubs", "django-stubs-ext", "djangorestframework-stubs"],
      // By default Renovate puts a major update on its own
      // "renovate/major-mypy-django-stubs" branch even when it shares a group,
      // splitting it from the releases of the other packages that unblock it.
      // Own block because Renovate forbids combining matchUpdateTypes with
      // separateMajorMinor in a single rule.
      "separateMajorMinor": false,
    },
    {
      "matchPackageNames": ["mypy"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "mypy and django stubs",
      "groupSlug": "mypy-django-stubs",
    },
    {
      "matchPackageNames": ["django-stubs", "django-stubs-ext", "djangorestframework-stubs"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "groupName": "mypy and django stubs",
      "groupSlug": "mypy-django-stubs",
    },
    // Group all non-major @biomejs/biome updates together (npm devDependencies,
    // peerDependencies, and biome.jsonc schema from customManagers:biomeVersions).
    // Matching by package name ensures all three stay in a single PR.
    {
      "matchPackageNames": ["@biomejs/biome"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps",
    },
    // GitHub Actions ("uses:" steps in workflows) are CI tooling, so every
    // update to them, including major, goes into the "dev dependencies" PR.
    // Unlike Python/npm dev tool majors, action majors are routine and CI
    // exercises the new version directly. No matchUpdateTypes, so all update
    // types land here. separateMajorMinor must be false, or a major would go
    // on its own "renovate/major-dev-deps" branch despite sharing the group
    // (see the mypy rule above). Only depType "action" is matched: the same
    // manager also extracts "services:" images and "runs-on" runners, which
    // are not dev tooling.
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "separateMajorMinor": false,
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps",
    },
    // .python-version: use "docker" versioning so "3.12" stays "3.12" (not
    // "3.12.0" or "3.12.11"). Override the default PR title ("python Docker
    // tag") to say "Python version". Remind to update requires-python.
    {
      "matchManagers": ["pyenv"],
      "versioning": "docker",
      "groupName": "Python version",
      "commitMessageTopic": "Python version",
      "prBodyNotes": [
        "**Remember:** also update `requires-python` in `pyproject.toml` to match the new Python version.",
      ],
    },
    // Group all Node.js version references and only bump on majors. Node
    // here is tooling-only (Biome, Vite); minor/patch changes don't affect
    // tooling output, and runtime resolution picks up patches automatically.
    // Covers references such as:
    // - `actions/setup-node` `node-version` in GitHub Actions workflows
    // - `image: node:...` in docker-compose files
    // - the `version` option of `ghcr.io/devcontainers/features/node` in
    //   devcontainer.json (extracted as `node`)
    // "rangeStrategy: replace" preserves the existing version-string shape,
    // so existing references must already be in major-only form (`node:24`,
    // not `node:24.15.0`) for this to behave as intended.
    {
      "matchDepNames": ["node"],
      "rangeStrategy": "replace",
      "versioning": "docker",
      "groupName": "Node version",
      "commitMessageTopic": "Node version",
      // Node LTS (even-numbered majors).
      "allowedVersions": "/^\\d*[02468](\\..*)?$/",
    },
    {
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "enabled": false,
    },
    // Track @types/node to the Node major version. Major bumps join the
    // "Node version" PR; minor/patch updates continue to flow through the
    // dev-deps group as usual. Two blocks because Renovate forbids combining
    // matchUpdateTypes with allowedVersions in a single rule.
    {
      "matchPackageNames": ["@types/node"],
      // Node LTS (even-numbered majors).
      "allowedVersions": "/^\\d*[02468](\\..*)?$/",
    },
    {
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "Node version",
      "commitMessageTopic": "Node version",
    },
    // The lock file handles version pinning even without an explicit version
    // constraint, so where a range exists in .tf files it's intentional for
    // compatibility reasons — preserve it rather than pinning to an exact version.
    {
      "matchManagers": ["terraform"],
      "rangeStrategy": "replace",
    },
    // Disable required_version updates in Terraform, as it's only a compatibility
    // constraint and tight bounds make runtime compatibility difficult.
    {
      "matchManagers": ["terraform"],
      "matchDepNames": ["hashicorp/terraform"],
      "enabled": false,
    },
    // Renovate cannot enforce minimumReleaseAge for these update types and
    // managers — it has no releaseTimestamp to check. Exempt them to avoid a
    // permanently-pending stability-days status. See:
    // https://github.com/renovatebot/renovate/issues/41652
    // https://github.com/renovatebot/renovate/issues/38656
    {
      "matchUpdateTypes": ["lockFileMaintenance", "replacement", "pin", "pinDigest", "digest"],
      // null instead of "0 days" to skip the check entirely
      "minimumReleaseAge": null,
      "prBodyNotes": [
        "⚠️ Minimum release age is not validated for this update type.",
      ],
    },
    {
      "matchManagers": ["copier", "devcontainer"],
      "minimumReleaseAge": null,
    },
    // Resonant packages are first-party — trust them immediately.
    {
      "matchPackageNames": [
        "django-auth-style",
        "django-resonant-settings",
        "django-resonant-utils",
        "django-s3-file-field",
        "@resonant/biome-config",
        "@resonant/oauth-client",
      ],
      "minimumReleaseAge": "0 days",
    },
  ],
}
